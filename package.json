{
  "name": "multiocular",
  "version": "0.8.4",
  "description": "Review dependencies changes to prevent supply chain attack",
  "keywords": [
    "dependencies",
    "npm",
    "pnpm",
    "security",
    "supply chain attack"
  ],
  "license": "MIT",
  "author": "Andrey Sitnik <andrey@sitnik.es>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai/multiocular.git"
  },
  "bin": "./server/bin.ts",
  "type": "module",
  "exports": {
    "./server": "./server/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "FORCE_COLOR=1 pnpm run /^test:/",
    "start": "pnpm run /^start:/",
    "build": "rm -Rf dist && pnpm run /^build:/",
    "visual": "STORYBOOK=1 storybook dev -c web/.storybook -p 31339 --no-open --host 0.0.0.0",
    "format": "pnpm run /^format:/",
    "update-env": "node ./scripts/update-env.ts",
    "build-visual": "NODE_ENV=test storybook build -c web/.storybook",
    "test:real": "node --run build && TEST_BIN=./dist/server/bin.js pnpm bnt",
    "test:js": "eslint --cache --concurrency auto .",
    "test:css": "stylelint **/*.css **/*.svelte",
    "test:types": "svelte-check",
    "test:audit": "pnpm audit --prod",
    "test:web": "node --run build:web",
    "start:web": "vite web/ --host 0.0.0.0 --port 31338",
    "start:server": "node --env-file=.env --watch ./server/bin.ts --web",
    "build:web": "vite build web/",
    "build:server": "node ./scripts/build-server.ts",
    "format:js": "eslint --fix --cache --concurrency auto .",
    "format:oxfmt": "oxfmt .",
    "format:css": "stylelint --fix **/*.css **/*.svelte"
  },
  "dependencies": {
    "@logux/actions": "0.8.1",
    "@logux/server": "^0.17.1",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "nanostores": "^1.5.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/jacquard-12": "5.3.0",
    "@logux/client": "0.27.0",
    "@logux/eslint-config": "57.1.0",
    "@logux/oxc-configs": "^1.2.0",
    "@logux/stylelint-config": "1.1.0",
    "@mdi/js": "7.4.47",
    "@storybook/addon-svelte-csf": "5.1.5",
    "@storybook/addon-themes": "10.6.3",
    "@storybook/svelte": "10.6.3",
    "@storybook/svelte-vite": "10.6.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/libnpmdiff": "2.0.3",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "autoprefixer": "10.6.1",
    "better-node-test": "1.0.0",
    "escape-html": "1.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-prefer-let": "^4.2.2",
    "eslint-plugin-svelte": "3.23.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "keyux": "0.11.6",
    "nano-staged": "1.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss": "8.5.31",
    "postcss-dark-theme-class": "2.0.0",
    "postcss-html": "2.0.0",
    "postcss-load-config": "6.0.1",
    "react": "19.3.1",
    "storybook": "10.6.3",
    "stylelint": "17.16.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "svelte-eslint-parser": "1.9.0",
    "svgo": "4.1.0",
    "ts-blank-space": "0.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  }
}
